{
  "version": 1,
  "purpose": "Internal product-market research. This source map is not the X content ranking and does not assign market demand by source popularity.",
  "sources": [
    {
      "id": "etsy-marketplace-insights",
      "name": "Etsy Marketplace Insights",
      "url": "https://help.etsy.com/hc/en-us/articles/35122361353239-How-Do-I-Use-Etsy-s-Marketplace-Insights-Tool",
      "access": "manual_seller_dashboard",
      "signal_type": "buyer_search_and_competition",
      "collect": [
        "keyword",
        "market_or_region",
        "searches_last_30_days",
        "listings_last_30_days",
        "related_terms",
        "checked_at"
      ],
      "limitations": [
        "Requires Shop Manager access",
        "Free tier currently allows 15 keyword searches per week",
        "Search activity is not sales or willingness-to-pay proof"
      ]
    },
    {
      "id": "etsy-seller-handbook",
      "name": "Etsy Seller Handbook and Trend Reports",
      "url": "https://www.etsy.com/in-en/seller-handbook",
      "access": "public_pages",
      "signal_type": "market_context",
      "collect": [
        "trend",
        "reported_metric",
        "scope_or_region",
        "period",
        "source_url",
        "checked_at"
      ],
      "limitations": [
        "Trend reports may use US signed-in buyer data",
        "Broad trend does not prove demand for a specific product"
      ]
    },
    {
      "id": "appsumo-marketplace",
      "name": "AppSumo marketplace and reviews",
      "url": "https://appsumo.com/",
      "access": "public_pages",
      "signal_type": "paid_competition_and_objections",
      "collect": [
        "product",
        "buyer",
        "price",
        "review_count",
        "rating",
        "purchase_count_if_disclosed",
        "negative_review_themes",
        "checked_at"
      ],
      "limitations": [
        "Deal audiences can be unusually price-sensitive",
        "Review counts are not directly comparable",
        "Partner stories may have selection bias"
      ]
    },
    {
      "id": "gumroad-discover",
      "name": "Gumroad Discover",
      "url": "https://gumroad.com/help/article/79-gumroad-discover",
      "access": "public_pages",
      "signal_type": "priced_digital_products_and_competitors",
      "collect": [
        "product",
        "buyer",
        "format",
        "price",
        "reviews_if_visible",
        "sales_proof_if_disclosed",
        "checked_at"
      ],
      "limitations": [
        "A listing alone does not reveal sales",
        "Discover eligibility is biased toward creators who already made at least USD 100 in genuine sales and passed review"
      ]
    },
    {
      "id": "shopify-community",
      "name": "Shopify Community",
      "url": "https://community.shopify.com/latest.rss",
      "access": "public_rss",
      "signal_type": "merchant_problem_frequency",
      "collect": [
        "problem",
        "buyer_role",
        "workaround",
        "date",
        "reply_count_if_available",
        "source_url"
      ],
      "limitations": [
        "Forum posts are not representative samples",
        "A request is not proof of paid demand"
      ]
    },
    {
      "id": "shopify-app-store",
      "name": "Shopify App Store",
      "url": "https://apps.shopify.com/",
      "access": "public_pages",
      "signal_type": "paid_competitors_and_customer_complaints",
      "collect": [
        "app",
        "price_or_plan",
        "reviews",
        "negative_review_themes",
        "recurring_missing_workflows",
        "checked_at"
      ],
      "limitations": [
        "Reviewers self-select",
        "Existing complaints require validation with additional merchants"
      ]
    },
    {
      "id": "wordpress-plugin-directory",
      "name": "WordPress.org Plugin Directory API",
      "url": "https://developer.wordpress.org/reference/functions/plugins_api/",
      "access": "public_api",
      "signal_type": "plugin_adoption_and_feedback",
      "collect": [
        "plugin",
        "active_installs",
        "downloads",
        "rating_percent",
        "num_ratings",
        "last_updated",
        "support_issue_theme"
      ],
      "limitations": [
        "Many plugins are free; installs and reviews do not prove paid demand"
      ]
    },
    {
      "id": "google-trends",
      "name": "Google Trends",
      "url": "https://trends.google.com/trends/explore",
      "access": "manual_export",
      "signal_type": "relative_search_interest",
      "collect": [
        "keyword_or_topic",
        "region",
        "date_range",
        "comparison_terms",
        "trend_index",
        "checked_at"
      ],
      "limitations": [
        "Normalized 0-100 relative index, not absolute search volume",
        "Small samples and spikes can mislead"
      ]
    },
    {
      "id": "indie-hackers",
      "name": "Indie Hackers",
      "url": "https://indiehackers.com/",
      "access": "public_discussions_and_unofficial_feed",
      "signal_type": "founder_cases_and_reported_revenue",
      "collect": [
        "business_model",
        "buyer",
        "stated_revenue_or_sales",
        "time_period",
        "distribution_channel",
        "source_url",
        "verification_status"
      ],
      "limitations": [
        "Claims may be self-reported",
        "Successful cases are subject to survivorship bias"
      ]
    },
    {
      "id": "reddit-communities",
      "name": "Specialist Reddit communities",
      "url": "https://www.reddit.com/",
      "access": "manual_research_or_approved_api",
      "signal_type": "pain_language_and_workarounds",
      "collect": [
        "community",
        "problem",
        "buyer_role",
        "workaround",
        "date",
        "engagement",
        "source_url"
      ],
      "limitations": [
        "Votes and anecdotes are not payment data",
        "Follow platform terms and community rules"
      ]
    },
    {
      "id": "hacker-news",
      "name": "Hacker News / Show HN",
      "url": "https://news.ycombinator.com/",
      "access": "public_api",
      "signal_type": "tech_product_discovery_and_discussion",
      "collect": [
        "product",
        "discussion",
        "objections",
        "points",
        "comments",
        "source_url"
      ],
      "limitations": [
        "Audience skews technical",
        "Votes and comments are not market size"
      ]
    },
    {
      "id": "shopify-digital-products",
      "name": "Shopify Digital Products documentation",
      "url": "https://help.shopify.com/en/manual/products/digital-service-product/digital-downloads",
      "access": "public_primary_source",
      "signal_type": "supported_digital_product_formats_and_delivery",
      "collect": [
        "format",
        "delivery_method",
        "constraints",
        "source_url",
        "checked_at"
      ],
      "limitations": [
        "Explains platform capabilities, not buyer demand"
      ]
    },
    {
      "id": "stripe-blog",
      "name": "Stripe Blog",
      "url": "https://stripe.com/blog/feed.rss",
      "access": "public_rss",
      "signal_type": "payments_and_commerce_context",
      "collect": [
        "topic",
        "release_or_trend",
        "date",
        "source_url"
      ],
      "limitations": [
        "Editorial context, not direct demand evidence"
      ]
    },
    {
      "id": "ahrefs-blog",
      "name": "Ahrefs Blog",
      "url": "https://ahrefs.com/blog/feed",
      "access": "public_rss",
      "signal_type": "seo_and_distribution_context",
      "collect": [
        "topic",
        "search_strategy",
        "date",
        "source_url"
      ],
      "limitations": [
        "Search content does not establish sales for a particular product"
      ]
    },
    {
      "id": "woocommerce-blog",
      "name": "WooCommerce Blog",
      "url": "https://woocommerce.com/posts/feed",
      "access": "public_rss",
      "signal_type": "commerce_and_seller_workflow_context",
      "collect": [
        "topic",
        "workflow",
        "date",
        "source_url"
      ],
      "limitations": [
        "Announcements and advice are not direct demand evidence"
      ]
    }
  ],
  "minimum_evidence_rule": {
    "independent_source_groups": 3,
    "distinct_problem_reports": 20,
    "competitor_products_to_review": 10,
    "requirement": "Before serious build work, identify an actual buyer and repeated problem, inspect competitor negative reviews, prove a plausible no-paid-ads acquisition path, and test willingness to pay with strangers."
  }
}
